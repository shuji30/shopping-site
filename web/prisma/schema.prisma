// Prisma スキーマ。学習用に SQLite を使用（本番は datasource を差し替え）。
// 参考: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// 着物商品
model Kimono {
  id          String   @id
  name        String
  category    String
  price       Int
  rentalDays  Int
  /// JSON 文字列（SQLite は配列型を持たないため）
  sizes       String
  colors      String
  images      String
  material    String
  description String
  inStock     Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/// 予約申込（1件の申込）
model Reservation {
  id          String            @id @default(cuid())
  orderNumber String            @unique
  name        String
  kana        String?
  email       String
  tel         String
  /// "delivery" | "store"
  method      String
  address     String?
  note        String?
  total       Int
  /// "reserved" | "shipped" | "returned" | "cancelled"
  status      String            @default("reserved")
  /// オンライン決済の状態: "unpaid" | "paid"
  paymentStatus String          @default("unpaid")
  createdAt   DateTime          @default(now())
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items       ReservationItem[]
}

/// 会員ユーザー
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime      @default(now())
  sessions     Session[]
  reservations Reservation[]
}

/// ログインセッション（トークンを httpOnly Cookie に保存し照合）
model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// 予約申込の明細（1点のレンタル）
model ReservationItem {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  kimonoId      String
  name          String
  size          String
  startDate     String
  rentalDays    Int
  price         Int
}

/// 送信メールの記録（サンプルのため実送信はせず DB に保存する）
model EmailLog {
  id            String   @id @default(cuid())
  to            String
  subject       String
  body          String
  /// メール種別: "reservation_confirmation" など
  kind          String
  /// 関連する予約（あれば）
  reservationId String?
  createdAt     DateTime @default(now())
}
