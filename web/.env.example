# このファイルをコピーして .env を作成してください: cp .env.example .env
# SQLite（開発用）。スキーマファイル(prisma/schema.prisma)からの相対パス。
DATABASE_URL="file:./dev.db"

# 本番でTurso（libSQL、無料枠）を使う場合は上のDATABASE_URLをコメントアウトし、
# 代わりに以下2つを設定する（`turso db show <db名> --url` / `turso db tokens create <db名>` の出力）。
# DATABASE_URL="libsql://<db名>-<組織名>.turso.io"
# TURSO_AUTH_TOKEN="<turso db tokens create で発行したトークン>"

# 管理画面(/admin)の Basic 認証。ADMIN_PASSWORD が空だと管理画面は全拒否される。
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me"
